# Copy to .env.local for development.

# Postgres. On the VM this points at the local cluster or Cloud SQL.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/churchviewer

# The domain churches hang off. In production: churchviewer.com
#
# Locally use lvh.me — it and every subdomain resolve to 127.0.0.1 via public
# DNS, so grace.lvh.me:3000 just works. Plain `localhost` will NOT do: browsers
# never send a localhost cookie to sub.localhost, so you'd be signed out the
# moment you left the apex. (Offline? Add the hosts entries yourself and use any
# dotted name.) This is inlined at build time — rebuild after changing it.
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000

# Google sign-in. Create an OAuth client (type: web) in the ChurchViewer GCP
# project and add https://churchviewer.com/api/auth/google/callback (and
# http://lvh.me:3000/api/auth/google/callback) as redirect URIs.
# Leave both blank to hide the Google button entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloud Storage bucket for uploaded recordings. Leave blank and the admin UI
# accepts pasted links only. The VM's service account needs
# roles/storage.objectAdmin plus iam.serviceAccounts.signBlob for signed URLs.
GCS_BUCKET=
